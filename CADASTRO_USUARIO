<?php
include 'conexao.php';
$erro    = "";
$sucesso = "";
if (isset($_POST['cadastrar'])):
    $senha = filter_input(INPUT_POST, 'senha', FILTER_DEFAULT);
    $email = $_POST['email'];

    // Validação da senha
    if (!preg_match('/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/', $senha)) {
        $erro = "A senha deve ter no mínimo 8 caracteres, incluindo letra maiúscula, minúscula e número.";
    // Validação do email
    } elseif (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $erro = "Email inválido!";
    } else {
        $senha_crip = password_hash($senha, PASSWORD_DEFAULT);
        $sql = mysqli_query($conexao, "INSERT INTO `usuario` (`email`, `senha`) VALUES ('$email', '$senha_crip')");

        if ($sql) {
            $sucesso = "Cadastro realizado com sucesso!";
        } else {
            $erro = "Erro ao cadastrar. Tente novamente.";
        }
    }
endif;
?>
