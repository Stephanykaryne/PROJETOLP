<?php
session_start();

if (!isset($_SESSION['usuario'])) {
    header("Location: login.php");
    exit();
}

include 'conexao.php';

// ── Exclusão por nome ─────────────────────────────────────────────────────────
if (isset($_GET['excluir']) && $_GET['excluir'] !== "") {
    $nome_del = mysqli_real_escape_string($conexao, $_GET['excluir']);
    mysqli_query($conexao, "DELETE FROM `objetos` WHERE `nome` = '$nome_del' LIMIT 1");
    header("Location: listar.php?msg=excluido");
    exit();
}

// ── Edição via POST ───────────────────────────────────────────────────────────
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['editar_nome'])) {
    $nome_original = mysqli_real_escape_string($conexao, $_POST['nome_original']);
    $novo_nome     = trim(mysqli_real_escape_string($conexao, $_POST['editar_nome']));
    $nova_qtd      = max(0, intval($_POST['editar_quantidade']));

    if ($novo_nome !== "") {
        mysqli_query($conexao,
            "UPDATE `objetos` SET `nome` = '$novo_nome', `quantidade` = $nova_qtd
             WHERE `nome` = '$nome_original' LIMIT 1"
        );
    }
    header("Location: listar.php?msg=editado");
    exit();
}

// ── Busca e ordenação ─────────────────────────────────────────────────────────
$busca   = trim($_GET['busca'] ?? "");
$ordem   = in_array($_GET['ordem'] ?? "", ['nome', 'quantidade']) ? $_GET['ordem'] : 'nome';
$dir     = ($_GET['dir'] ?? 'ASC') === 'DESC' ? 'DESC' : 'ASC';
$dir_inv = $dir === 'ASC' ? 'DESC' : 'ASC';

$where = "";
if ($busca !== "") {
    $busca_seg = mysqli_real_escape_string($conexao, $busca);
    $where = "WHERE `nome` LIKE '%$busca_seg%'";
}

// ── Contagem total ────────────────────────────────────────────────────────────
$res_total = mysqli_query($conexao, "SELECT COUNT(*) AS total FROM `objetos` $where");
if (!$res_total) {
    die("Erro: " . mysqli_error($conexao) . "<br>Verifique se a tabela se chama <strong>objetos</strong>.");
}
$total = (int) mysqli_fetch_assoc($res_total)['total'];

// ── Paginação ─────────────────────────────────────────────────────────────────
$por_pagina = 10;
$pagina     = max(1, intval($_GET['pagina'] ?? 1));
$total_pags = max(1, (int) ceil($total / $por_pagina));
$pagina     = min($pagina, $total_pags);
$offset     = ($pagina - 1) * $por_pagina;

$resultado = mysqli_query($conexao,
    "SELECT `nome`, `quantidade` FROM `objetos` $where ORDER BY `$ordem` $dir LIMIT $por_pagina OFFSET $offset"
);
if (!$resultado) {
    die("Erro: " . mysqli_error($conexao));
}

$msg = $_GET['msg'] ?? "";
?>
